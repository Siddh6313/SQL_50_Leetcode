# Here we have to use Left join as Using simply Join(i.e. Inner Join) will show only records that are common in both table, 
# so our condition to show emp name whose bonus is null will not be met. So will use Left Join instead of Join

Select e.name, b.bonus
    from Employee e
    Left Join Bonus b on e.empId = b.empId
    where b.bonus<1000 or b.bonus is null

